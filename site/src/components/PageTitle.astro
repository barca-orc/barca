---
// Starlight's page title, with a low search weight on design records and contributor pages
// (Pagefind weights an h1 7x by default, which put RFC titles above the reference). The id
// matches Starlight's PAGE_TITLE_ID, which the package does not export.
const { entry } = Astro.locals.starlightRoute;
const id = entry.id;
const lowRank = (id.startsWith('rfcs/') && id !== 'rfcs/template') || id.startsWith('contributing/');
---

<h1 id="_top" data-pagefind-weight={lowRank ? '0.1' : undefined}>{entry.data.title}</h1>

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
