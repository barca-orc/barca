---
// Lists docs pages with their descriptions, read from the content collection so a new page
// shows up without editing an index by hand.
//   <PageIndex prefix="patterns/" />          pages under one section, in file order
//   <PageIndex all />                         every user-facing page, A to Z, with its section
import { getCollection } from 'astro:content';

interface Props {
  prefix?: string;
  all?: boolean;
}
const { prefix, all = false } = Astro.props;

const SECTIONS: [string, string][] = [
  ['patterns/', 'Recipe'],
  ['workflows/', 'Worked example'],
  ['comparisons/', 'Comparison'],
  ['reference/', 'Reference'],
];
const SECTION_INDEXES = ['reference', 'patterns', 'workflows', 'comparisons', 'rfcs', 'contributing', '404'];

const docs = await getCollection('docs');
let pages = docs.filter((d) => {
  if (d.id === 'index') return false;
  if (all) {
    if (d.id.startsWith('rfcs') || d.id.startsWith('contributing')) return false;
    if (SECTION_INDEXES.includes(d.id)) return false;
    return true;
  }
  return d.id.startsWith(prefix ?? '') && d.id !== (prefix ?? '').replace(/\/$/, '');
});

// The "Kind" label says a page is a worked example, so the title's prefix is not repeated.
const clean = (t: string) => t.replace(/^Worked Example:\s*/, '');
const sortKey = clean;
pages = all
  ? pages.sort((a, b) => sortKey(a.data.title).localeCompare(sortKey(b.data.title)))
  : pages.sort((a, b) => a.id.localeCompare(b.id));

const letterOf = (p: (typeof pages)[number]) => sortKey(p.data.title).charAt(0).toUpperCase();
const letters = [...new Set(pages.map(letterOf))];
const groups = letters.map((l) => [l, pages.filter((p) => letterOf(p) === l)] as const);
const section = (id: string) => SECTIONS.find(([p]) => id.startsWith(p))?.[1] ?? 'Guide';
---

{
  all && (
    <nav class="az-jump" aria-label="Jump to letter">
      {letters.map((l) => (
        <a href={`#letter-${l.toLowerCase()}`}>{l}</a>
      ))}
    </nav>
  )
}

{
  all ? (
    groups.map(([letter, group]) => (
      <section class="az-group">
        <h2 id={`letter-${letter.toLowerCase()}`}>{letter}</h2>
        <ul class="page-index" role="list">
          {group.map((p) => (
            <li>
              <a href={`/${p.id}/`}>{clean(p.data.title)}</a>
              <span class="kind">{section(p.id)}</span>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <ul class="page-index" role="list">
      {pages.map((p) => (
        <li>
          <a href={`/${p.id}/`}>{clean(p.data.title)}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .az-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-bottom: 1rem;
    font-family: var(--sl-font-mono);
  }
  .az-jump a {
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }
  .az-group h2 {
    margin-top: 1.5rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xl);
    color: var(--sl-color-accent-high);
    scroll-margin-top: 5rem;
  }
  .page-index {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.25rem 1.5rem;
  }
  .page-index li {
    margin: 0;
    padding: 0.75rem 0;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .page-index a {
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
  }
  .page-index a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .page-index .kind {
    margin-inline-start: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .page-index p {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
</style>
