---
// Text links to the main entry points before the GitHub icon, so every page (the splash
// homepage has no sidebar) can reach the docs, recipes and the A-Z list in one click.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const path = Astro.url.pathname;
const links = [
  { label: 'Recipes', href: '/patterns/', match: (p: string) => p.startsWith('/patterns') || p.startsWith('/workflows') },
  { label: 'CLI', href: '/reference/cli/', match: (p: string) => p.startsWith('/reference/cli') },
  { label: 'All Pages', href: '/reference/', match: (p: string) => p === '/reference/' },
  { label: 'Changelog', href: '/contributing/changelog/', match: (p: string) => p.startsWith('/contributing/changelog') },
];
links.unshift({
  label: 'Get Started',
  href: '/getting-started/',
  match: (p: string) => p.startsWith('/getting-started'),
});
---

<nav class="top-links" aria-label="Top">
  {
    links.map((l) => (
      <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>
<Default />

<style>
  .top-links {
    display: flex;
    gap: 1.25rem;
    margin-inline-end: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .top-links a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .top-links a:hover,
  .top-links a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  @media (min-width: 50rem) and (max-width: 72rem) {
    .top-links a:last-child,
    .top-links a:nth-last-child(2) {
      display: none;
    }
  }
</style>
