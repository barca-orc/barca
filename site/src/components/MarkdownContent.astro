---
// Wraps Starlight's MarkdownContent. Contributor pages rank below
// the user docs in search, and an RFC says up front that it is a design record, so a search
// hit on a proposal is never mistaken for the reference.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const id = Astro.locals.starlightRoute.entry.id;
const isRfc = id.startsWith('rfcs/') && id !== 'rfcs/template';
const isProject = isRfc || id.startsWith('contributing/');
// Pages written to answer a question in its reader's words rank above long reference pages that
// mention the same words in passing ("csv changed", "cron").
const BOOST: Record<string, string> = {
  troubleshooting: '3',
  scheduling: '2',
  // A comparison that names cron in every line outranked the how-to for "cron".
  'comparisons/cron': '0.3',
  // The CLI reference is the home of the exit-code table; the contract repeats it in full.
  'reference/cli-contract': '0.5',
};
const weight = isProject ? '0.1' : BOOST[id];
---

<div data-pagefind-weight={weight}>
  {
    isRfc && (
      <aside class="rfc-note" aria-label="About this page">
        <strong>Design record.</strong> This RFC explains why and how a feature was designed. For
        how barca behaves today, see the <a href="/all-pages/">reference</a>; where they disagree,
        the reference is right.
      </aside>
    )
  }
  <Default><slot /></Default>
</div>

<style>
  .rfc-note {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .rfc-note a {
    color: var(--sl-color-text-accent);
  }
</style>
