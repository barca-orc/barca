---
// Wraps Starlight's MarkdownContent. Contributor pages rank below
// the user docs in search, and an RFC says up front that it is a design record, so a search
// hit on a proposal is never mistaken for the reference.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const id = Astro.locals.starlightRoute.entry.id;
const isRfc = id.startsWith('rfcs/') && id !== 'rfcs/template';
const isProject = isRfc || id.startsWith('contributing/');
// Pages written to answer a question in its reader's words rank above long reference pages that
// mention the same words in passing ("csv changed", "cron").
const BOOST: Record<string, string> = {
  troubleshooting: '3',
  scheduling: '2',
  serve: '2',
  auth: '2',
  // A short command page; the how-to is Authentication and Tokens.
  'reference/cli/tokens': '0.5',
  // A comparison that names cron in every line outranked the how-to for "cron".
  'comparisons/cron': '0.1',
  // The CLI reference is the home of the exit-code table; the contract repeats it in full.
  'reference/cli-contract': '0.2',
  // Every release note names a feature; the pages that explain it should rank first.
  releases: '0.2',
};
const weight = isProject ? '0.1' : BOOST[id];
// Words people type in a whole-sentence search that a page answers without using them all.
// Pagefind matches every word of a query, so "asset didn't rerun after csv changed" needs
// "didn't" and "after" somewhere on the page that answers it.
const KEYWORDS: Record<string, string> = {
  troubleshooting:
    "asset didn't rerun after csv changed, file changed, data changed, not updating, stale result, why did it run, why didn't it run, rerun, recompute, cache not invalidated",
  auth: 'login, log in, password, require a token, authentication, access control, secure the server, api key',
  serve: 'which server page, which page, server, deploy the server, team server, server overview, start here, where to start with the server',
  scheduling: 'cron, crontab, run on a cron schedule, run every day, run nightly, schedule a job, timer',
  'reference/refresh': 'force a recompute, force rerun, rerun everything, ignore cache, bust cache, invalidate cache',
  releases: "changelog, change log, what's new, whats new, latest release, latest version, release notes, upgrade, breaking changes",
  'web-ui': 'ui status colors, colours, icons, what the states mean, dashboard',
};
const keywords = KEYWORDS[id];
---

<div data-pagefind-weight={weight}>
  {
    isRfc && (
      <aside class="rfc-note" aria-label="About this page">
        <strong>Design record.</strong> This RFC explains why and how a feature was designed. For
        how barca behaves today, see the <a href="/all-pages/">reference</a>; where they disagree,
        the reference is right.
      </aside>
    )
  }
  <Default><slot /></Default>
  {keywords && <p class="search-keywords" aria-hidden="true" data-pagefind-weight="10">{keywords}</p>}
</div>

<style>
  .search-keywords {
    display: none;
  }
  .rfc-note {
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border-inline-start: 3px solid var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .rfc-note a {
    color: var(--sl-color-text-accent);
  }
</style>
